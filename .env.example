# ============================================
# REQUIRED: Portal Vhost Configuration
# ============================================
# These MUST be set as environment variables before running tests

# Portal vhost hostname (used in Host header for API requests)
PORTAL_HOST=account.pinner.xyz

# ============================================
# REQUIRED: Renterd Configuration
# ============================================
# These MUST be set as environment variables before running tests

# Renterd API URL (e.g., http://localhost:9980/ or http://your-renterd-host:9980/)
# For local testing with mock renterd: http://localhost:8081
RENTERD_URL=http://localhost:8081

# Renterd API password
RENTERD_API_PASSWORD=mock-password

# ============================================
# Usage
# ============================================
# For local testing:
# 1. Copy this file to .env
# 2. Fill in the required values above
# 3. Run: make setup-env
# 4. Run: make run-portal
#
# For GitHub Actions:
# Set these as repository secrets: RENTERD_URL, RENTERD_API_PASSWORD
